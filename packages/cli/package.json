{
  "name": "proof-pr",
  "version": "1.0.0",
  "description": "CLI for ProofPR, an AI PR intake gate for maintainers and teams.",
  "license": "MIT",
  "type": "module",
  "homepage": "https://github.com/linsk-labs/proof-pr#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/linsk-labs/proof-pr.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/linsk-labs/proof-pr/issues"
  },
  "keywords": [
    "github-action",
    "pull-request",
    "pull-request-review",
    "pr-triage",
    "pr-intake",
    "pull-request-gate",
    "code-review",
    "maintainers",
    "maintainer-tools",
    "open-source",
    "security",
    "security-tools",
    "secrets-scanning",
    "github-actions-security",
    "dependency-review",
    "sarif",
    "code-scanning",
    "ai-coding",
    "ai-generated-code",
    "ai-pr",
    "mcp",
    "mcp-security",
    "cli"
  ],
  "bin": {
    "proof-pr": "dist/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && ncc build build/index.js -o dist --license licenses.txt",
    "test": "vitest run src --passWithNoTests",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@proof-pr/core": "workspace:*",
    "@vercel/ncc": "^0.38.4",
    "commander": "^14.0.2"
  }
}
