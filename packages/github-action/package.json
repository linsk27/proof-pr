{
  "name": "@proof-pr/github-action",
  "version": "0.1.1",
  "description": "GitHub Action entrypoint for ProofPR.",
  "license": "MIT",
  "type": "module",
  "private": true,
  "homepage": "https://github.com/linsk27/proof-pr#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/linsk27/proof-pr.git",
    "directory": "packages/github-action"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && ncc build dist/index.js -o action-dist --license licenses.txt",
