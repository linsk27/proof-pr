{
  "name": "@proof-pr/github-action",
  "version": "0.1.0",
  "description": "GitHub Action entrypoint for ProofPR.",
  "license": "MIT",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json && ncc build dist/index.js -o action-dist --license licenses.txt",
